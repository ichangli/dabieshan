{
  "name": "dabieshan-ecological-resources",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:demo": "npm run type-check && vite build --mode demo",
    "type-check": "vue-tsc --build",
    "server": "node --env-file-if-exists=server/.env server/server.js",
    "dev:full": "run-p server dev",
    "dev:demo": "vite --mode demo",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@arcgis/core": "^5.0.19",
    "html2pdf.js": "^0.14.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^8.0.4",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
